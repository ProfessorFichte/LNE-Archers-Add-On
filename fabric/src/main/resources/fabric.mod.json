{
	"schemaVersion": 1,
	"id": "lne_archers",
	"version": "${version}",
	"name": "LNE Archers Add-On",
	"description": "Loot & Explore Add-On with Archers RPG-Series Content.",
	"authors": [
		"Fichte"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/lne-archers",
		"sources": "https://github.com/ProfessorFichte/LNE-Archers-Add-On",
		"issues": "https://github.com/ProfessorFichte/LNE-Archers-Add-On/issues"
	},
	"license": "ARR",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"com.lne_archers.fabric.client.FabricClient"
		],
		"main": [
          "com.lne_archers.fabric.FabricMod"
		],
		"fabric-datagen": [
			"com.lne_archers.Lne_archersDataGenerator"
		]
	},
	"mixins": [
		"lne_archers.mixins.json"
	],
	"depends": {
